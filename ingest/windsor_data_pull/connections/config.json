        { "id": "504047196", "name": "Schneider (USD)", "client": "schneider", "label": "Schneider", "expected": "standby", "alerts": false, "consumers": [] },
        { "id": "516221072", "name": "Schneider (SGD)", "client": "schneider", "label": "Schneider", "expected": "standby", "alerts": false, "consumers": [] },
        { "id": "515691430", "name": "STT", "client": "stt", "label": "STT", "expected": "standby", "alerts": false, "consumers": [], "why": "stt reads raw_snowflake" },
        { "id": "511609128", "name": "STT", "client": "stt", "label": "STT", "expected": "standby", "alerts": false, "consumers": [] },
