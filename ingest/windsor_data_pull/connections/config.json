      "accounts": [
        { "id": "0lw3hp6", "name": "Caltex Star Card", "client": "caltex", "label": "Caltex", "expected": "daily", "alerts": true, "consumers": ["caltex"] },
        { "id": "lxp46o9", "name": "ResetData", "client": "resetdata", "label": "Reset Data", "expected": "daily", "alerts": true, "consumers": ["resetdata"] },
