{
  "_doc": [
    "Windsor connections probe - the ONE place that says which Windsor accounts we depend on,",
    "which client each belongs to, whether a dashboard actually reads it, and when each connector",
    "was last re-authorised. probe.py reads this; the Grid's Connections tab renders the result.",
    "",
    "Per account: id (as the LOADER stores it, prefix-free), name, client (registry key), label,",
    "expected = daily | ended | standby | retired | snapshot, alerts = whether a bad state EMAILS",
    "(false for accounts no dashboard reads - they still show on the tab, they just cannot page us).",
    "Per datasource: grant.last_reauth (the day the connector was last re-authorised in Windsor),",
    "grant.reauth_by, grant.token_lifetime_days (the platform's TYPICAL lifetime; Windsor exposes no",
    "expiry, so expiry_estimate = last_reauth + lifetime and the UI labels it an estimate).",
    "last_reauth is the SEED only: the probe OBSERVES re-grants itself (Windsor's ds-accounts list gaining ids, or an",
    "account flipping not_granted -> granted) and uses the later of the two dates. Edit it only to correct history."
  ],
  "recipients": ["ian@100.digital", "charles@100.digital"],
  "digest_hour_utc": 22,
  "expiry_warn_days": 14,
  "frozen_after_days": 3,
  "probe_window_days": 3,
  "datasources": [
    {
      "ds": "facebook",
      "label": "Meta Ads",
      "endpoint": "https://connectors.windsor.ai/all",
      "prefix": "facebook__",
      "fields": "account_id,account_name,date,impressions",
      "table": "raw_windsor.perf_meta",
      "key_col": "account_id",
      "loader_job": "windsor-meta-ingest",
      "schedule": "21:15 UTC daily",
      "loader_file": "ingest/windsor_data_pull/meta/meta_loader.py",
      "grant": { "last_reauth": "2026-08-25", "reauth_by": "Calvin", "token_lifetime_days": 60,
                 "note": "Meta long-lived user tokens last ~60 days; the 2026-08-11 lapse was exactly this." },
      "accounts": [
        { "id": "3754165911553001", "name": "100% Digital - Clients", "client": "geocon", "label": "Geocon", "expected": "daily", "alerts": true,
          "consumers": ["geocon", "nextsmile", "bellshakespeare"] },
        { "id": "465058559225771", "name": "Reset backup - Ad account", "client": "resetdata", "label": "Reset Data", "expected": "daily", "alerts": true,
          "consumers": ["resetdata"] },
        { "id": "1126027130805483", "name": "Cityperfume.com.au", "client": "cityperfume", "label": "City Perfume", "expected": "ended", "alerts": false,
          "consumers": ["cityperfume"], "why": "client offboarded 2026-09-01; dashboards deleted, data retained" },
        { "id": "1302148091859257", "name": "unknown (never delivered)", "client": null, "label": "Unmapped", "expected": "retired", "alerts": false },
        { "id": "910485528634664", "name": "Ad Assembly - ACRS", "client": null, "label": "Ad Assembly", "expected": "retired", "alerts": false, "why": "no rows since 2026-05-01" },
        { "id": "927205350157043", "name": "Ad Assembly - BuyerX", "client": null, "label": "Ad Assembly", "expected": "retired", "alerts": false, "why": "no rows since 2026-05-29" }
      ]
    },
    {
      "ds": "tradedesk",
      "label": "The Trade Desk",
      "endpoint": "https://connectors.windsor.ai/tradedesk",
