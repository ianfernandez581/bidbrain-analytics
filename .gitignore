# Secrets / keys (NEVER commit)
*.p8
*.pub
*.pem
*.key
*-key.json
*credentials*.json
service-account*.json
.env
# Bare-named private keys (no extension) — these slipped past *.key before
*_key
mirror_key
id_rsa
id_ecdsa
id_ed25519

# Local data & logs
chunks/
*.log
# Raw client report exports (manual drops -> seeded into BigQuery, never committed)
clients/*/data/*
# EXCEPTION: schneider's media-plan TARGET seeds live in data/ and ARE version-controlled
# (committed-CSV->BQ standard; other clients keep theirs in targets/). Track just these.
!clients/client_schneider/data/media_plan.csv
!clients/client_schneider/data/plan_budget.csv
!clients/client_schneider/data/targets.csv
!clients/client_schneider/data/campaign_map.csv
!clients/client_schneiderlqai/data/media_plan.csv

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.ndjson
_run/

# Claude Code harness / session state (not part of the project) -- but DO track the shared
# team slash commands under .claude/commands/ (/push, /ship) and the shared team skills under
# .claude/skills/ (agent guidance that encodes repo rules). Ignore everything else.
.claude/*
!.claude/commands/
!.claude/skills/

# Per-developer branch name remembered by scripts/push-branch.ps1 (machine-local)
scripts/.devname

# Personal timesheet / work-record exports (per-developer, for ClickUp). The repo rule is that
# the git log is the changelog, so narrative summaries of one's own work stay out of the tree.
DEV_WORK_*.md

# Local client-demo previews (static design snapshots incl. a data.json copy — never commit).
# Serve with staging/serve.ps1 to show a redesign to a client before deploying it.
staging/

grid-core/files/CREATIVE/LinkedIn Video Ads/
grid-core/files/CREATIVE/Consideration - LinkedIn Document ads/
*.zip
*.mp4

# Session working documents - the narrative notes/assessments a session writes WHILE working
# (health assessments, exposure analyses, QA/build scratch). The git log is the changelog, so these
# are never committed; without this, push-branch.ps1 (which commits ALL local work) sweeps them
# into main. The files stay on disk - this only stops them being tracked.
#
# ROOT-ANCHORED ("/" prefix) ON PURPOSE. These docs are always written at the repo root, and an
# unanchored *_NOTES.md would also swallow deliberately-tracked nested deliverables - specifically
# prototypes/transmission-feedback-v0/QA_NOTES.md. Keep the leading slash when adding entries.
/PLATFORM_HEALTH_ASSESSMENT.md
/EXTRABLACK_NOTES.md
/EXTRABLACK_EXPOSURE.md
/EXTRABLACK_EXPOSURE_2.md
/EXTRABLACK_DEPLOY.md
/DATA_ACCURACY_NOTES.md
/QA_NOTES.md
/BUILD_NOTES.md
/*_NOTES.md
/*_ASSESSMENT.md
/*_EXPOSURE*.md

# Office lock/owner files (created while a workbook or doc is OPEN, e.g.
# ~$pacing_intake_template.xlsx). Never work product; they are locked by Office
# so they cannot even be deleted before a push, and /push commits ALL local work.
~$*
